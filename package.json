{
  "name": "high-roller",
  "version": "0.1.1",
  "description": "A mobile-first 3D dice matching roguelite prototype",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "simulate": "node modelling/cli.mjs",
    "simulate:legacy": "node scripts/simulate.mjs",
    "simulate:sweep": "node modelling/cli.mjs --scenarios all --policies greedy,spender --runs 200 --samples 4 --out modelling/results/sensitivity",
    "simulate:smoke": "node modelling/cli.mjs --runs 10 --policies greedy,spender --samples 2 --out modelling/results/smoke"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "three": "0.186.0",
    "vite": "7.3.6"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
